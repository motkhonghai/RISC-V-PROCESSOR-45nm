@file 74: # At stage 1 only check categories that are valid immediately after importing
@file 75: # the handoff. Place/CTS/route/signoff checks belong to their own later stages.
@@file 76: check_design -type [list \
    library \
    netlist \
    synthesis \
    power_intent \
    timing \
    hierarchical \
    assign_statements \
    extract_rc] \
    > ${REPORT_PATH}/check_design_input.rpt
@file 86:
@file 87: # Check clocks, exceptions and timing constraints independently from the
@file 88: # structural/library checks above.
@@file 89: check_timing -verbose \
    > ${REPORT_PATH}/check_timing.rpt
