@file 44: ###############################
@file 45: # Final post-route timing/DRV recovery
@file 46: ###############################
@file 47: # route_opt_design can insert transparent fillers before its final recovery.
@file 48: # Remove those fillers so post-route optimization has legal sites for delay
@file 49: # cells and buffers, then optimize against the final routed parasitics.
@@file 50: delete_filler -cells $FILLER_CELLS -prefix FILLER
