#@ Begin verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/2_floorplan_power.tcl (pre)
@file 1: ###############################################################################
@file 2: # Stage 2: Floorplan, I/O placement and power planning
@file 3: # Run: innovus -stylus -files 2_floorplan_power.tcl
@file 4: ###############################################################################
@file 5:
@file 6: ###############################
@file 7: # Setup - global variables
@file 8: ###############################
@file 9: set STAGE  2_floorplan_power
@file 10: set DESIGN picorv32
@file 11:
@file 12: set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
@file 13: cd $PROJECT_PATH
@file 14:
@file 15: set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_init
@file 16: set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
@file 17: set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/2_floorplan_power
@file 18: set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_floorplan_power
@file 19: set IO_FILE     ${PROJECT_PATH}/physical_design/pins_mmmc.io
@file 20:
@file 21: set POWER_NET       VDD
@file 22: set GROUND_NET      VSS
@file 23:
@file 24: # 900 sites x 106 rows; about 60% initial utilization at 19514.52 um^2.
@file 25: set CORE_SITE       CoreSite
@file 26: set CORE_WIDTH      180.0
@file 27: set CORE_HEIGHT     181.26
@file 28: # Ring needs 0.6 offset + 2 * 2.0 width + 1.0 spacing = 5.6 um per side.
@file 29: set CORE_MARGIN     10.0
@file 30:
@file 31: file mkdir $OUTPUT_PATH
@file 32: file mkdir $REPORT_PATH
@file 33:
@file 34: ###############################
@file 35: # Use in-memory design or read input database
@file 36: ###############################
@file 37: # run_full.tcl keeps the design in memory. A standalone stage reloads the
@file 38: # checkpoint written by its predecessor.
@file 39: if {[info exists PD_DATABASE_LOADED] && $PD_DATABASE_LOADED} {
@file 40: puts "Use design already loaded in memory"
Use design already loaded in memory
@file 41: }
@file 48:
@file 49: ###############################
@file 50: # Create floorplan with room for power rings inside the die
@file 51: ###############################
@file 52: # -core_size: width height left bottom right top (um).
@file 53: # Do not predict/reshape afterwards: that can remove the ring margin.
@@file 54: create_floorplan -site $CORE_SITE -core_size \
    $CORE_WIDTH $CORE_HEIGHT \
    $CORE_MARGIN $CORE_MARGIN $CORE_MARGIN $CORE_MARGIN
**WARN: (IMPFP-4026):	Adjusting core to 'Bottom' to 10.070000 due to track/row misalignment. To force the value, specify the -no_snap_to_grid option or use floorplan_set_snap_rule command to specify the die/core to different grid.
**WARN: (IMPFP-4026):	Adjusting core to 'Top' to 10.070000 due to track/row misalignment. To force the value, specify the -no_snap_to_grid option or use floorplan_set_snap_rule command to specify the die/core to different grid.
