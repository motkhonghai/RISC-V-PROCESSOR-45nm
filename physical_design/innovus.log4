@file 75: ###############################
@@file 76: connect_global_net $POWER_NET  -type pg_pin -pin $POWER_NET  -inst_base_name *
@@file 77: connect_global_net $GROUND_NET -type pg_pin -pin $GROUND_NET -inst_base_name *
@@file 78: connect_global_net $POWER_NET  -type tie_hi
@@file 79: connect_global_net $GROUND_NET -type tie_lo
@file 80:
@file 81: ###############################
@file 82: # Create power rings
@file 83: ###############################
@@file 84: set_db add_rings_skip_shared_inner_ring none
@@file 85: set_db add_rings_avoid_short true
add_rings command will avoid shorts while creating rings.
@@file 86: set_db add_rings_ignore_rows false
add_rings command will consider rows while creating rings.
@@file 87: set_db add_rings_extend_over_row false
add_rings command will disallow rings to go over rows.
@file 88:
@@file 89: add_rings \
    -type core_rings \
    -nets [list $POWER_NET $GROUND_NET] \
    -follow core \
    -layer [list bottom Metal11 top Metal11 right Metal10 left Metal10] \
    -width 2.0 \
    -spacing 1.0 \
    -offset 0.6 \
    -jog_distance 0.6 \
    -threshold 0.6
