@file 46: # Path groups exported inside a mode-specific SDC are ignored by Innovus
@file 47: # (TA-976). Recreate them here as global path groups for all active views.
@file 48: set DATA_INPUTS [all_inputs -no_clocks]
@file 49: set REGISTERS   [all_registers]
@file 50:
@file 51: if {[sizeof_collection $REGISTERS] > 0} {
