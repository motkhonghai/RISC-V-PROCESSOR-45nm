set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
cd $PROJECT_PATH
set SCRIPT_PATH  ${PROJECT_PATH}/physical_design
#@ source ${SCRIPT_PATH}/1_init_design.tcl
#@ Begin verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/1_init_design.tcl (pre)
set STAGE  1_init_design
set DESIGN picorv32
set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
cd $PROJECT_PATH
set INPUT_DB    ${PROJECT_PATH}/synthesis/outputs/mmmc/INVS
set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/1_init_design
set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_init
set PROCESS_NODE 45
set TOP_ROUTING_LAYER Metal11
set CTS_BUFFER_CELLS [list CLKBUFX8 CLKBUFX16 CLKBUFX20]
set CTS_INVERTER_CELLS [list CLKINVX8 CLKINVX16 CLKINVX20]
set TIE_CELLS [list TIELO TIEHI]
file mkdir $OUTPUT_PATH
file mkdir $REPORT_PATH
set_db init_power_nets  VDD
set_db init_ground_nets VSS
if {![file exists $INPUT_DB]} {...}
read_db -common $INPUT_DB
set PD_DATABASE_LOADED true
set DATA_INPUTS [all_inputs -no_clocks]
set REGISTERS   [all_registers]
if {[sizeof_collection $REGISTERS] > 0} {
group_path -name I2C -from $DATA_INPUTS -to $REGISTERS
group_path -name R2R -from $REGISTERS -to $REGISTERS
group_path -name C2O -from $REGISTERS -to [all_outputs]
}
group_path -name I2O -from $DATA_INPUTS -to [all_outputs]
set_db design_process_node $PROCESS_NODE
set_db timing_analysis_cppr both
set_db timing_analysis_type ocv
set_db design_top_routing_layer $TOP_ROUTING_LAYER
set_db cts_buffer_cells $CTS_BUFFER_CELLS
set_db cts_inverter_cells $CTS_INVERTER_CELLS
set_db add_tieoffs_cells $TIE_CELLS
puts "MMMC analysis views: [get_db analysis_views]"
check_design -type [list \
    library \
    netlist \
    synthesis \
    timing \
    hierarchical \
    assign_statements \
    extract_rc] \
    > ${REPORT_PATH}/check_design_input.rpt
check_timing -verbose \
    > ${REPORT_PATH}/check_timing.rpt
write_db $OUTPUT_DB
puts "Done $STAGE"
puts "Saved database: $OUTPUT_DB"
#@ End verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/1_init_design.tcl
#@ source ${SCRIPT_PATH}/2_floorplan_power.tcl
#@ Begin verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/2_floorplan_power.tcl (pre)
set STAGE  2_floorplan_power
set DESIGN picorv32
set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
cd $PROJECT_PATH
set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_init
set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/2_floorplan_power
set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_floorplan_power
set IO_FILE     ${PROJECT_PATH}/physical_design/pins_mmmc.io
set POWER_NET       VDD
set GROUND_NET      VSS
set CORE_SITE       CoreSite
set CORE_WIDTH      180.0
set CORE_HEIGHT     181.26
set CORE_MARGIN     10.0
file mkdir $OUTPUT_PATH
file mkdir $REPORT_PATH
if {[info exists PD_DATABASE_LOADED] && $PD_DATABASE_LOADED} {
puts "Use design already loaded in memory"
}
create_floorplan -site $CORE_SITE -core_size \
    $CORE_WIDTH $CORE_HEIGHT \
    $CORE_MARGIN $CORE_MARGIN $CORE_MARGIN $CORE_MARGIN
if {![file exists $IO_FILE]} {...}
read_io_file $IO_FILE
set_db finish_floorplan_active_objs [list macro soft_blockage core]
connect_global_net $POWER_NET  -type pg_pin -pin $POWER_NET  -inst_base_name *
connect_global_net $GROUND_NET -type pg_pin -pin $GROUND_NET -inst_base_name *
connect_global_net $POWER_NET  -type tie_hi
connect_global_net $GROUND_NET -type tie_lo
set_db add_rings_skip_shared_inner_ring none
set_db add_rings_avoid_short true
set_db add_rings_ignore_rows false
set_db add_rings_extend_over_row false
add_rings \
    -type core_rings \
    -nets [list $POWER_NET $GROUND_NET] \
    -follow core \
    -layer [list bottom Metal11 top Metal11 right Metal10 left Metal10] \
    -width 2.0 \
    -spacing 1.0 \
    -offset 0.6 \
    -jog_distance 0.6 \
    -threshold 0.6
add_stripes \
    -nets [list $POWER_NET $GROUND_NET] \
    -layer Metal10 \
    -width 1.0 \
    -spacing 1.5 \
    -set_to_set_distance 20.0 \
    -merge_stripes_value 0.6 \
    -max_same_layer_jog_length 0.44 \
    -pad_core_ring_bottom_layer_limit Metal9 \
    -pad_core_ring_top_layer_limit Metal11 \
    -block_ring_bottom_layer_limit Metal9 \
    -block_ring_top_layer_limit Metal11
route_special \
    -connect core_pin \
    -nets [list $POWER_NET $GROUND_NET] \
    -layer_change_range [list Metal1(1) Metal11(11)] \
    -crossover_via_layer_range [list Metal1(1) Metal11(11)] \
    -target_via_layer_range [list Metal1(1) Metal11(11)] \
    -core_pin_target first_after_row_end \
    -allow_jogging true \
    -allow_layer_change true
report_timing -late -max_paths 20 > ${REPORT_PATH}/timing.rpt
write_db $OUTPUT_DB
puts "Done $STAGE"
puts "Saved database: $OUTPUT_DB"
#@ End verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/2_floorplan_power.tcl
#@ source ${SCRIPT_PATH}/3_placement.tcl
#@ Begin verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/3_placement.tcl (pre)
set STAGE  3_placement
set DESIGN picorv32
set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
cd $PROJECT_PATH
set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_floorplan_power
