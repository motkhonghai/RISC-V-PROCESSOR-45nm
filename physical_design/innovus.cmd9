#@ source ${SCRIPT_PATH}/4_cts.tcl
#@ Begin verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/4_cts.tcl (pre)
set STAGE  4_cts
set DESIGN picorv32
set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
cd $PROJECT_PATH
set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_place
set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/4_cts
set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_post_cts
file mkdir $OUTPUT_PATH
file mkdir $REPORT_PATH
if {[info exists PD_DATABASE_LOADED] && $PD_DATABASE_LOADED} {
puts "Use design already loaded in memory"
}
check_design -type cts \
    > ${REPORT_PATH}/check_design_cts.rpt
clock_opt_design
set_interactive_constraint_modes [all_constraint_modes -active]
set_propagated_clock [all_clocks]
report_timing -late  -max_paths 50 > ${REPORT_PATH}/setup.rpt
report_timing -early -max_paths 50 > ${REPORT_PATH}/hold.rpt
report_clock_trees -out_file ${REPORT_PATH}/clock_trees.rpt
report_skew_groups -out_file ${REPORT_PATH}/skew_groups.rpt
write_db $OUTPUT_DB
puts "Done $STAGE"
puts "Saved database: $OUTPUT_DB"
#@ End verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/4_cts.tcl
#@ source ${SCRIPT_PATH}/5_routing.tcl
#@ Begin verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/5_routing.tcl (pre)
set STAGE  5_routing
set DESIGN picorv32
set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
cd $PROJECT_PATH
set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_post_cts
set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/5_routing
set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_post_route
set FILLER_CELLS [list FILL64 FILL32 FILL16 FILL8 FILL4 FILL2 FILL1]
file mkdir $OUTPUT_PATH
file mkdir $REPORT_PATH
if {[info exists PD_DATABASE_LOADED] && $PD_DATABASE_LOADED} {
puts "Use design already loaded in memory"
}
set_db opt_fix_hold_verbose true
route_opt_design -setup -hold
delete_filler -cells $FILLER_CELLS -prefix FILLER
set_db opt_post_route_area_reclaim hold_and_setup_aware
set_db opt_hold_target_slack 0.010
opt_design -post_route -drv -setup -hold \
    -hold_violation_report ${REPORT_PATH}/unfixed_hold
set_db add_fillers_cells $FILLER_CELLS
add_fillers
route_eco
report_timing -late  -max_paths 50 > ${REPORT_PATH}/setup.rpt
report_timing -early -max_paths 50 > ${REPORT_PATH}/hold.rpt
write_db $OUTPUT_DB
puts "Done $STAGE"
puts "Saved database: $OUTPUT_DB"
#@ End verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/5_routing.tcl
#@ source ${SCRIPT_PATH}/6_chip_finish.tcl
#@ Begin verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/6_chip_finish.tcl (pre)
set STAGE  6_chip_finish
set DESIGN picorv32
set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
cd $PROJECT_PATH
set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_post_route
set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/6_chip_finish
set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_finish
file mkdir $OUTPUT_PATH
file mkdir $REPORT_PATH
if {[info exists PD_DATABASE_LOADED] && $PD_DATABASE_LOADED} {
puts "Use design already loaded in memory"
}
set_db delaycal_enable_si true
set_db extract_rc_engine post_route
set_db extract_rc_effort_level high
extract_rc
report_timing -late  -max_paths 100 > ${REPORT_PATH}/setup.rpt
report_timing -early -max_paths 100 > ${REPORT_PATH}/hold.rpt
report_area  > ${REPORT_PATH}/area.rpt
report_power > ${REPORT_PATH}/power.rpt
check_drc > ${REPORT_PATH}/drc.rpt
check_connectivity > ${REPORT_PATH}/connectivity.rpt
write_db $OUTPUT_DB
puts "Done $STAGE"
puts "Saved database: $OUTPUT_DB"
#@ End verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/6_chip_finish.tcl
#@ source ${SCRIPT_PATH}/7_export.tcl
#@ Begin verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/7_export.tcl (pre)
set STAGE  7_export
set DESIGN picorv32
set PROJECT_PATH /home/icd1/workspace/RISC-V-PROCESSOR-45nm
cd $PROJECT_PATH
set INPUT_DB    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_finish
set OUTPUT_PATH ${PROJECT_PATH}/physical_design/outputs/mmmc
set REPORT_PATH ${PROJECT_PATH}/physical_design/reports/mmmc/7_export
set OUTPUT_DB   ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_final
set NETLIST     ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_post_pnr.v
set DEF_FILE    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_post_pnr.def
set SLOW_SDC    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_post_pnr_slow_setup_view.sdc
set FAST_SDC    ${PROJECT_PATH}/physical_design/outputs/mmmc/picorv32_post_pnr_fast_hold_view.sdc
file mkdir $OUTPUT_PATH
file mkdir $REPORT_PATH
if {[info exists PD_DATABASE_LOADED] && $PD_DATABASE_LOADED} {
puts "Use design already loaded in memory"
}
write_db $OUTPUT_DB
write_netlist $NETLIST
write_def $DEF_FILE
write_sdc -view slow_setup_view > $SLOW_SDC
write_sdc -view fast_hold_view > $FAST_SDC
puts "GDS not exported: supply matching cell GDS and a verified stream map first."
puts "Final runtime and memory:"
time_info FINAL
puts "Done $STAGE"
puts "Saved database: $OUTPUT_DB"
puts "Netlist: $NETLIST"
puts "DEF: $DEF_FILE"
#@ End verbose source /home/icd1/workspace/RISC-V-PROCESSOR-45nm/physical_design/7_export.tcl
puts "Full physical-design flow completed"
#@ End verbose source: run_full.tcl
exit
