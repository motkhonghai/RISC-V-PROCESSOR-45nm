@file(run_mmmc.tcl) 88: set HAS_REGISTERS [expr {[llength [all_registers]] > 0}]
@file(run_mmmc.tcl) 90: foreach VIEW [get_db analysis_views -if {.is_setup == true}] {
    if {$HAS_REGISTERS} {
        group_path \
            -name I2C \
            -from [all_inputs -no_clocks] \
            -to [all_registers] \
            -view $VIEW

        group_path \
            -name R2R \
            -from [all_registers] \
            -to [all_registers] \
            -view $VIEW

        group_path \
            -name C2O \
            -from [all_registers] \
            -to [all_outputs] \
            -view $VIEW
    }

    group_path \
        -name I2O \
        -from [all_inputs -no_clocks] \
        -to [all_outputs] \
        -view $VIEW
}
