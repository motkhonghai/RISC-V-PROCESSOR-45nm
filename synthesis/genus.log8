@file(run_mmmc.tcl) 106: set HAS_REGISTERS [expr {[llength [all_registers]] > 0}]
@file(run_mmmc.tcl) 108: if {$HAS_REGISTERS} {
    group_path \
        -name I2C \
        -from [all_inputs -no_clocks] \
        -to [all_registers]

    group_path \
        -name R2R \
        -from [all_registers] \
        -to [all_registers]

    group_path \
        -name C2O \
        -from [all_registers] \
        -to [all_outputs]
}
